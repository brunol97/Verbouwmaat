# ───────────────────────────────────────────
# Vercel (wordt automatisch gezet)
# VERCEL_ENV=preview | production
# VERCEL_URL=xxx.vercel.app
# ───────────────────────────────────────────

# ───────────────────────────────────────────
# Supabase — DEV / Preview (o)
# Project: jouwapp-dev
# ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# ───────────────────────────────────────────
# Supabase — PRODUCTIE (p)
# Project: jouwapp-prod
# Wordt alleen gebruikt in production builds
# ───────────────────────────────────────────
SUPABASE_URL_PROD=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY_PROD=your-prod-anon-key

# ───────────────────────────────────────────
# PostHog (1 project, onderscheid via environment property)
# ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ───────────────────────────────────────────
# AI API Keys (voor Pi factory CI)
# ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
